# Star Trek Galaxies -- sprites for the Trek event pictures our anomalies use.
#
# A NEW file, not a shadow. STNH ships ~1,430 event pictures and declares them
# in interface/STH_event_pictures.gfx, which .docs/architecture/stnh-art.md does
# not take from it -- so 805 of them were inert bytes the clutter closure pruned
# every build. A picture here is a picture that comes back.
#
# TWO SPRITES PER PICTURE, which is vanilla's own convention and not decoration:
# interface/eventpictures.gfx says "the Situation Log automatically uses sprites
# with the _nomask suffix if available", so a picture with only the masked twin
# is drawn through the event mask in the log as well as the popup.
#
# The art is 620x264 or a 9315x264 animation strip in .source/; `target: family`
# on gfx/event_pictures in vendor.yml re-cuts it to vanilla's 450x150 at harvest.
# WITHOUT THAT THIS FILE IS DECISION 40'S DEFECT: UIOD's eventwindow.gui draws
# at scale = 1.5 inside a 693x239 frame, so 620x264 art renders 930x396.
# See .docs/decisions/69-event-picture-families.md.
#
# Sprite names take the `stg_` prefix -- we invented them, no vendored art
# references them, so decision 09's exception does not apply.
# See .docs/decisions/70-trek-anomalies.md

spriteTypes = {

	# ── Asteroids, hulks and debris ───────────────────────────────────────────
	spriteType = {
		name = "GFX_evt_stg_dilithium_matrix"
		texturefile = "gfx/event_pictures/dilithium_incubator.dds"
		masking_texture = "gfx/interface/situation_log/event_mask.dds"
		alwaystransparent = yes
	}
	spriteType = {
		name = "GFX_evt_stg_dilithium_matrix_nomask"
