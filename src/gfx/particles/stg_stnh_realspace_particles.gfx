# A REAL MERGE, not an override -- the same collision as
# src/gfx/models/planets/stg_stnh_space_dust_meshes.gfx, one directory over.
# Real Space 4.0 and STNH both ship gfx/particles/realspace_generic_particles.gfx;
# Real Space wins the path, STNH is additive_only, and the STNH entity file we
# DO vendor (gfx/models/ships/other/realspace_other_entities.asset) then names
# dust-cloud and globule particles nothing declares.
#
# Only the declarations Real Space's copy does not make are below. Each `type`
# resolves to a sibling .asset now vendored from STNH under gfx/particles/.

objectTypes = {

	
	pdxparticle = {
		name = "azure_dust_cloud_effect"
		type = "azure_dust_cloud_effect"
		scale = 1.0
	}

	pdxparticle = {
		name = "red_dust_cloud_effect"
		type = "red_dust_cloud_effect"
		scale = 1.0
	}

	pdxparticle = {
