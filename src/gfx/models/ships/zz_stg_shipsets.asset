	locator = { name = "medium_gun_02" position = { -2.243 0.686 -0.689 } }
	locator = { name = "medium_gun_03" position = { 1.810 0.324 -0.392 } }
	locator = { name = "medium_gun_04" position = { -2.243 0.324 -0.095 } }
	locator = { name = "titan_gun_01" position = { 1.810 0.686 0.202 } }
	locator = { name = "part2" position = { 0.000 0.000 0.000 } }
	locator = { name = "part3" position = { 0.000 0.000 0.000 } }
}
