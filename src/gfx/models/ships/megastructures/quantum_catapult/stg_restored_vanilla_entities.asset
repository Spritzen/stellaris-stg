# Vanilla 4.4 entity declarations that a vendored file at the same path drops.
#
# A NEW file, not a shadow. Real Space - System Scale wins
# gfx/models/ships/megastructures/quantum_catapult/quantum_catapult_01.asset,
# and its pre-4.4 copy declares none of the 24 entities below — the Biogenesis,
# cybernetics, infernal, toxoid and wilderness catapult shipsets. Vanilla's
# 13_quantum_catapult.txt names them per graphical culture. Latent, not
# measured: nothing built a catapult in the 90-second 2026-08-02 session.
#
# SCALE is the one edit to vanilla's text below: Real Space adds
# `scale = @catapult_scale` to every catapult it declares, so restored ones take
# the same line and its value rather than coming out a third of the size.

@catapult_scale = 3
# `@` variables are FILE-scoped, so @quantum_catapult_size has to be redeclared
# here even though vanilla declares it in the file this one supplements.
# Omitting it produced six `Malformed token` records in the 2026-08-02 13:35 run.
# Vanilla's value, verbatim.
@quantum_catapult_size = 400

entity = {
	name = "toxoid_01_quantum_catapult_stage_1_entity"
	pdxmesh = "quantum_catapult_stage_1_mesh"
	scale = @catapult_scale

	locator = { name = "root"	position = { 0 0 0 } }

	attach = { root = "quantum_catapult_stage_1_lightning_entity" }

	meshsettings = {
		name = "g_bodyShape"
		index = 0
		texture_diffuse = "toxoid_01_quantum_catapult_diffuse.dds"
		texture_normal = "toxoid_01_quantum_catapult_normal.dds"
		texture_specular = "toxoid_01_quantum_catapult_specular.dds"
		shader = "PdxMeshShip"
	}

	game_data = {
		size = @quantum_catapult_size
	}
}

