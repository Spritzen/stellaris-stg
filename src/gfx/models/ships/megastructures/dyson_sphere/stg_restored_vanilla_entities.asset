# Vanilla 4.4 entity declarations that a vendored file at the same path drops.
#
# A NEW file, not a shadow. Real Space - System Scale wins
# gfx/models/ships/megastructures/dyson_sphere/_dyson_sphere_entities.asset,
# and its pre-4.4 copy declares none of the 87 entities below — the Biogenesis,
# cybernetics, infernal, toxoid and wilderness Dyson sphere shipsets. Vanilla's
# common/megastructures/ still names them, so they fire the moment anyone builds
# one. Latent rather than measured: a 90-second session builds no megastructures.
#
# Blocks are vanilla's verbatim, so `scale = @dyson_scale`. The variable is
# declared below at Real Space's own value, taken from the file this one
# supplements, so a restored sphere matches the ones beside it. `@` variables in
# .asset files are file-scoped, so declaring it here affects nothing else.

@dyson_scale = 140
@dyson_size = 300
@flowmap_speed = 0.12
@flowmap_intensity = 0.21

entity = {
	name = "toxoid_01_dyson_sphere_frame_entity"
	pdxmesh = "dyson_sphere_frame_mesh"
	scale = @dyson_scale

	default_state = "idle"
	state = { name = "idle" state_time = 10
		start_event = { trigger_once = yes sound = { soundeffect = "dyson_sphere_treble_hum" } }
	}

	meshsettings = {
		name = "frame1Shape"
		index = 0
		texture_diffuse = "toxoid_01_dyson_sphere_diffuse.dds"
		texture_normal = "toxoid_01_dyson_sphere_normal.dds"
		texture_specular = "toxoid_01_dyson_sphere_specular.dds"
		shader = "PdxMeshShip"
	}

	game_data = {
		custom_texture = "gfx/models/ships/megastructures/dyson_sphere/dyson_sphere_01_construction_fadein.dds"
		emissive_recolor_crunch = 2.0
	}
}

entity = {
	name = "toxoid_01_dyson_sphere_part_1_entity"
	pdxmesh = "dyson_sphere_part_1_mesh"
	scale = @dyson_scale

	default_state = "idle"
	state = { name = "idle" state_time = 10
		start_event = { trigger_once = yes sound = { soundeffect = "dyson_sphere_bass_hum_partial" } }
	}

	meshsettings = {
		name = "pCylinder26|pCylinderShape2"
		index = 0
		texture_diffuse = "toxoid_01_dyson_sphere_diffuse.dds"
		texture_normal = "toxoid_01_dyson_sphere_normal.dds"
		texture_specular = "toxoid_01_dyson_sphere_specular.dds"
		shader = "PdxMeshShip"
