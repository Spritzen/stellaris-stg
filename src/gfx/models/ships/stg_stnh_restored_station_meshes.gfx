# DECLARE, don't shadow (.docs/architecture/conflict-register.md). Five pdxmesh declarations re-issued from
# STNH directories the ship prune removed, because .asset files in directories
# we KEEP still use them:
#
#   cardassian_01_orbital_station_mesh  <- federation/federation_deep_space.asset
#                                          andorian_01/andorian_01_deep_space.asset
#   dominion_01_base_mesh               <- andorian_01/andorian_01_deep_space.asset
#   klingon_shipyard_muesum_mesh        <- other/fed_ent_naval_museum.asset
#   talaxian_particle_fountain_mesh     <- federation/particle_base/particle_base_2.asset
#   voth_01_sovereign_coreA_mesh        <- federation/federation_special_ships.asset
#
# 26 of the 190 group-C records in the 2026-08-03 run. STNH's own .gfx files are
# NOT vendored: the four they live in declare 2, 3, 11, 20 and 77 meshes, so
# taking them whole would trade five dangling references for roughly a hundred
# more, in cultures decision 17 pruned on purpose. Each block below is STNH's
# verbatim, re-indented; the .mesh and .dds files they name are vendored by
# explicit include: entries in vendor.yml.

objectTypes = {

	pdxmesh = {
		name = "cardassian_01_orbital_station_mesh"
		file = "gfx/models/ships/cardassian_01/cardassian_01_orbital_station.mesh"
		scale = 2.25

		meshsettings = {
			texture_diffuse = "cardassian_01_orbital_station_diffuse.dds"
			texture_normal = "cardassian_01_orbital_station_normal.dds"
			texture_specular = "cardassian_01_orbital_station_specular.dds"
			index = 0
			shader = "PdxMeshShip"
		}
	}

