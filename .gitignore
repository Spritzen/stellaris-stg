# Build output
dist/

# The mod tree is GENERATED by `make vendor` from vendor.yml + src/, and runs
# to ~16 GB. Only vendor.yml and src/ are tracked; the tree is rebuildable.
# One directory rather than the twelve game folders this used to list, which is
# half the point of decision 12 -- a source mod shipping a new top-level folder
# no longer needs anyone to remember to add a line here.
# See .docs/architecture/vendored-merge.md.
/stg-build/
.vendor-manifest.json
.vendor-cache/

# The pinned copies of the source mods, ~18.7 GB. Taken from /workshop by
# `make sources-sync`; reflinked, so they cost almost no disk. Not tracked --
# sources.lock.yml records which revision of each is pinned, and that IS
# tracked. See .docs/decisions/08-source-snapshot.md.
/.source/

# CWTools language-server cache
.cwtools/
*.cwtools.cache

# .NET SDK scratch cache, created by editor tooling inside the container.
# Not a build input and not shipped -- .docs/reference/repo-layout.md.
/dotnet/

# Editor / OS noise
__pycache__/
.DS_Store
Thumbs.db
*.swp

# .docs/ is TRACKED, deliberately -- it is the documentation of record and every
# session is routed through it by CLAUDE.md. It was ignored here until
# 2026-08-09, which contradicted .docs/reference/repo-layout.md.

# Claude Code local state (sessions live in the mounted ~/.claude, not the repo)
.claude/settings.local.json
